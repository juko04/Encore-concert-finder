NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TICKETMASTER_API_KEY=

# Spotify Integration (Phase 2, PR #10)
# Spotify requires loopback IPv4 address for local OAuth (127.0.0.1, not localhost)
ENABLE_SPOTIFY_INTEGRATION=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/spotify/callback
# 32-byte (64-character hex) secret for AES-256-GCM token encryption at rest
SPOTIFY_TOKEN_ENCRYPTION_KEY=

