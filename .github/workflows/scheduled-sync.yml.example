# Production Multi-Horizon Scheduled Ingestion Workflow (Template)
#
# ARCHITECTURAL MODEL & INVARIANTS:
# Ticketmaster API has a strict 5,000 requests/day and 5 requests/sec account-wide limit.
# Because independent cloud workers running in parallel without shared state would exhaust
# rate limits and fail to coordinate quota consumption, production scheduled jobs MUST enforce:
#
# 1. Strict Job Serialization & Concurrency Semantics:
#    - Concurrency group `ticketmaster-ingestion` with `cancel-in-progress: false`.
#    - GITHUB CONCURRENCY LIMITATION: GitHub Actions maintains at most ONE pending queued run.
#      If multiple runs trigger while a job is executing, GitHub Actions cancels previously
#      queued pending jobs in favor of the latest run.
#    - DURABLE MISSED-RUN RECOVERY: To prevent intermediate horizons (mid-term, long-term) from
#      being silently lost if a scheduled run is canceled or delayed by GitHub platform load,
#      `sync-all-sources.ts` tracks durable sync checkpoints in `raw_ingests` and automatically
#      detects and recovers overdue horizons (>24h for near-term, >96h for mid-term, >192h for
#      long-term) within the allocated run request budget.
#
# 2. Ephemeral Quota Reconciliation:
#    - Every ephemeral runner discovers real-time account usage directly from Ticketmaster
#      response headers (`rate-limit`, `rate-limit-available`, `rate-limit-reset`) on the
#      very first request, synchronizing `TicketmasterQuotaGuard` without external Redis/cache.
#
# 3. Bounded Request Budget per Run:
#    - Near-term daily runs: bounded by `--max-requests=250` (~5% daily quota).
#    - Mid-term bi-weekly runs: bounded by `--max-requests=500` (~10% daily quota).
#    - Long-term weekly runs: bounded by `--max-requests=500` (~10% daily quota).
#    - Unused daily headroom (>3,500 requests) remains safely reserved for user queries and live operations.
#
# 4. Strict Failure Detection & Machine-Readable Summary:
#    - `sync-all-sources.ts` exits with code 0 on 100% complete success.
#    - Exits with code 2 on partial coverage or budget exhaustion.
#    - Exits with code 1 on source failure or fatal errors.
#    - Emits machine-readable `--json` artifact uploaded for operational monitoring.
#
# 5. Production Pre-Activation Checklist:
#    - Configure repository secret `SUPABASE_URL` (production instance).
#    - Configure repository secret `SUPABASE_SERVICE_ROLE_KEY`.
#    - Configure repository secret `TICKETMASTER_API_KEY`.
#    - Configure repository secret `ENCORE_APPROVED_PROD_HOSTS` (e.g. "aws-0-us-west-1.pooler.supabase.com,your-project.supabase.co").
#    - Configure repository secret `ENCORE_PROD_PROJECT_REF`.

name: Scheduled Ingestion Sync

on:
  schedule:
    # Near-term horizon (0-14 days): Every morning at 06:00 UTC
    - cron: '0 6 * * *'
    # Mid-term horizon (15-60 days): Every Wednesday and Sunday at 08:00 UTC
    - cron: '0 8 * * 0,3'
    # Long-term horizon (61-365 days): Every Saturday at 10:00 UTC
    - cron: '0 10 * * 6'
  workflow_dispatch:
    inputs:
      horizon:
        description: 'Scheduling horizon to synchronize'
        required: true
        default: 'auto'
        type: choice
        options:
          - auto
          - near-term
          - mid-term
          - long-term
          - full
      states:
        description: 'Comma-separated state codes (defaults to CO)'
        required: false
        default: 'CO'
        type: string
      max_requests:
        description: 'Maximum Ticketmaster requests for this run'
        required: false
        default: '250'
        type: string

# CRITICAL CONCURRENCY GUARD:
# Serializes ingestion execution to prevent quota race conditions across concurrent workers.
# Note: Pending runs are bounded by GitHub Actions queue depth = 1; missed schedules are
# guaranteed not to cause data starvation via durable SLA checkpoint recovery in sync-all-sources.ts.
concurrency:
  group: ticketmaster-ingestion
  cancel-in-progress: false

jobs:
  sync:
    name: Run Ingestion Sync
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Determine horizon from trigger
        id: horizon-selector
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "horizon=${{ github.event.inputs.horizon }}" >> $GITHUB_OUTPUT
            echo "states=${{ github.event.inputs.states }}" >> $GITHUB_OUTPUT
            echo "max_requests=${{ github.event.inputs.max_requests }}" >> $GITHUB_OUTPUT
          elif [ "${{ github.event.schedule }}" = "0 6 * * *" ]; then
            echo "horizon=near-term" >> $GITHUB_OUTPUT
            echo "states=CO" >> $GITHUB_OUTPUT
            echo "max_requests=250" >> $GITHUB_OUTPUT
          elif [ "${{ github.event.schedule }}" = "0 8 * * 0,3" ]; then
            echo "horizon=mid-term" >> $GITHUB_OUTPUT
            echo "states=CO" >> $GITHUB_OUTPUT
            echo "max_requests=500" >> $GITHUB_OUTPUT
          else
            echo "horizon=long-term" >> $GITHUB_OUTPUT
            echo "states=CO" >> $GITHUB_OUTPUT
            echo "max_requests=500" >> $GITHUB_OUTPUT
          fi

      - name: Execute Synchronized Ingestion
        id: sync
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          TICKETMASTER_API_KEY: ${{ secrets.TICKETMASTER_API_KEY }}
          ENCORE_APPROVED_PROD_HOSTS: ${{ secrets.ENCORE_APPROVED_PROD_HOSTS }}
          ENCORE_PROD_PROJECT_REF: ${{ secrets.ENCORE_PROD_PROJECT_REF }}
        run: |
          npm run sync:all -- \
            --live \
            --persist \
            --allow-production-write \
            --horizon=${{ steps.horizon-selector.outputs.horizon }} \
            --states=${{ steps.horizon-selector.outputs.states }} \
            --max-requests=${{ steps.horizon-selector.outputs.max_requests }} \
            --json > sync-summary.json
          cat sync-summary.json

      - name: Upload Synchronization Summary Artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ingestion-summary-${{ steps.horizon-selector.outputs.horizon }}
          path: sync-summary.json
          retention-days: 14
